# Copy this file to .env and fill in your own values.
# Variables marked "(prod)" are optional for local dev but required when
# answering real Telnyx calls.

# --- Mistral (STT, TTS, LLM) ---
# Required. https://console.mistral.ai
MISTRAL_API_KEY=

# --- Telnyx (telephony) ---
# Ed25519 public key (base64 DER) from the Telnyx portal. Webhook requests are
# rejected without it. Required (prod).
TELNYX_WEBHOOK_PUBLIC_KEY=
# Telnyx API key for Call Control (answering calls, starting media streams).
# Required (prod).
TELNYX_API_KEY=
# Shared secret appended to the /media-stream WebSocket URL so we can verify the
# stream really came from Telnyx. Use a long random string. Required (prod).
STREAM_AUTH_TOKEN=
# Publicly reachable HTTPS base URL of this server (e.g. https://abc123.ngrok.io
# for local dev, or your VPS domain). Required (prod).
PUBLIC_URL=

# --- Telegram (call notifications) ---
# Optional. If unset, transcript notifications are simply skipped.
TELEGRAM_API_KEY=
TELEGRAM_CHAT_ID=

# --- Server ---
# Optional. HTTP port the server listens on (default: 3000).
PORT=3000

# --- Persona ---
# Optional. Path to the base persona JSON file (default: persona.json). A
# persona.override.json, if present, is always merged on top of the base.
# See persona.override.json.example.
PERSONA_CONFIG=
